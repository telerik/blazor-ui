<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Telerik.UI.for.Blazor" VersionOverride="*" />
    <!-- Either include the NuGet package or the TelerikSvgIcons4, not both -->
    <!-- <PackageReference Include="TelerikSvgIcons4" VersionOverride="4.12.0" /> -->
    <ProjectReference Include="../TelerikSvgIcons4/TelerikSvgIcons4.csproj" />

    <!-- Icon package references are only necessary to show the workaround with Telerik UI for Blazor 15.2.0 or earlier -->
    <PackageReference Include="Telerik.SvgIcons" VersionOverride="5.*" />
    <PackageReference Include="Telerik.FontIcons" VersionOverride="5.*" />
  </ItemGroup>

</Project>
