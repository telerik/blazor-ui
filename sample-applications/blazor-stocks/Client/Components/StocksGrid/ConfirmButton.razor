<TelerikButton Icon="SvgIcon.Trash" Class="text-danger" OnClick="@( _ => WindowVisible = true )" Enabled="@Enabled">
    Remove
</TelerikButton>

<TelerikDialog @bind-Visible="@WindowVisible" Title="Confirm deleting" Width="400px">
    <DialogContent>
        Are you sure you want to delete this?
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="@(() => WindowVisible = false)">Cancel</TelerikButton>
        <TelerikButton OnClick="@RaiseConfirm" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)">Remove</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    bool WindowVisible { get; set; }
    async void RaiseConfirm()
    {
        WindowVisible = false;
        await OnConfirm.InvokeAsync(null);
    }
}