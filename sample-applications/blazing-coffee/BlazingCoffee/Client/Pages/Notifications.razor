@page "/notifications"

<CardContainer Title="Notifications">
    <div class="app-page">
        <div class="card-header-wrapper">
            <p class="app-page__intro">Updates about your team, sales reporting, and workspace preferences.</p>
            <TelerikButton OnClick="@MarkAllRead" Enabled="@Items.Any(item => !item.IsRead)">Mark all as read</TelerikButton>
        </div>

        <TelerikListView Data="@Items" Pageable="true" PageSize="5">
            <Template>
                @{
                    var notification = (NotificationItem)context;
                }
                <article class="notification-item" aria-label="@notification.Title">
                    <div class="notification-item__header">
                        <strong>@notification.Title</strong>
                        <span class="notification-item__time">@notification.Time</span>
                    </div>
                    <p>@notification.Message</p>
                    <span class="k-badge k-badge-md k-badge-solid @(notification.IsRead ? "k-badge-solid-base" : "k-badge-solid-info")">
                        @(notification.IsRead ? "Read" : "New")
                    </span>
                </article>
            </Template>
        </TelerikListView>
    </div>
</CardContainer>

@code {
    private List<NotificationItem> Items { get; } = new()
    {
        new() { Title = "August sales report is ready", Message = "Regional revenue is available for your review.", Time = "12 minutes ago" },
        new() { Title = "Lemon Team reached its service target", Message = "Customer follow-ups were completed ahead of the weekly goal.", Time = "Yesterday", IsRead = true },
        new() { Title = "Profile review reminder", Message = "Confirm your phone number before the September roster is published.", Time = "Monday", IsRead = true },
        new() { Title = "Coffee tasting scheduled", Message = "The new single-origin selection review begins Friday at 10:00.", Time = "August 20", IsRead = true },
        new() { Title = "Export completed", Message = "The employee engagement report was downloaded successfully.", Time = "August 18", IsRead = true }
    };

    private void MarkAllRead()
    {
        foreach (var notification in Items)
        {
            notification.IsRead = true;
        }
    }

    private sealed class NotificationItem
    {
        public string Title { get; init; }
        public string Message { get; init; }
        public string Time { get; init; }
        public bool IsRead { get; set; }
    }
}
