    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorHealthcareApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" sizes="48x48" href="favicon-48x48.png" />
