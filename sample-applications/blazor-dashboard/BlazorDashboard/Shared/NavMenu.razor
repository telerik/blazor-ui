<div class="legacy-nav-menu__topbar">
    <a class="legacy-nav-menu__brand" href="">BlazorDashboard</a>
    <button class="legacy-nav-menu__toggle" type="button" aria-label="Toggle navigation menu" aria-expanded="@(!collapseNavMenu)" @onclick="@ToggleNavMenu">
        <TelerikSvgIcon Icon="@SvgIcon.Menu" />
    </button>
</div>

<div class="@NavMenuCssClass" @onclick="@ToggleNavMenu">
    <ul class="legacy-nav-menu__list">
        <li class="legacy-nav-menu__item">
            <NavLink class="legacy-nav-menu__link" href="" Match="NavLinkMatch.All">
                Home
            </NavLink>
        </li>
        <li class="legacy-nav-menu__item">
            <NavLink class="legacy-nav-menu__link" href="counter">
                Counter
            </NavLink>
        </li>
        <li class="legacy-nav-menu__item">
            <NavLink class="legacy-nav-menu__link" href="fetchdata">
                Fetch data
            </NavLink>
        </li>
    </ul>
</div>

@code {
    bool collapseNavMenu = true;

    string NavMenuCssClass => collapseNavMenu ? "legacy-nav-menu__collapsed" : null;

    void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
