@using BlazorDashboard.Models
@using BlazorDashboard.DataRetrieval

@if (CurrIssue != null)
{
    <section class="issue-details__header">
        <div>
            <span class="k-badge k-badge-md k-badge-pill k-badge-solid @(CurrIssue.IsOpen ? " k-badge-success" : " k-badge-error")">
                @(CurrIssue.IsOpen ? "Open" : "Closed")
            </span>
            <h3 class="issue-details__title">
                @CurrIssue.Title
                <span class="issue-details__id">#@CurrIssue.Id</span>
            </h3>
        </div>
    </section>
    <dl class="issue-details__metadata">
        <div class="issue-details__metadata-item">
            <dt>Created on</dt>
            <dd>
            @CurrIssue.CreatedOn.ToString("dd MMMM yyyy")
            </dd>
        </div>
        @if (CurrIssue.ClosedOn.HasValue)
        {
            <div class="issue-details__metadata-item">
                <dt>Closed on</dt>
                <dd>
                @CurrIssue.ClosedOn.Value.ToString("dd MMMM yyyy")
                </dd>
            </div>
        }
        <div class="issue-details__metadata-item">
            <dt>Type</dt>
            <dd class="issue-details__value @LabelColors.GetClass(CurrIssue.Type.ToString())">@CurrIssue.Type</dd>
        </div>
        <div class="issue-details__metadata-item">
            <dt>Severity</dt>
            <dd class="issue-details__value @LabelColors.GetClass(CurrIssue.Severity.ToString())">@CurrIssue.Severity</dd>
        </div>
    </dl>
    <section class="issue-details__body">
        <div class="issue-details__labels">
            <h4>Labels</h4>
            <LabelsList CurrIssue="@CurrIssue"></LabelsList>
        </div>
        <div class="issue-details__description">
            <h4>Description</h4>
            <div class="issue-details__description-content">
                @(new MarkupString(CurrIssue.Description))
            </div>
        </div>
    </section>
}
else
{
    <div class="issue-details__notice" role="alert">
        Please select an issue to see its details.
    </div>
}

@code {
    [Parameter]
    public Issue CurrIssue { get; set; }
}