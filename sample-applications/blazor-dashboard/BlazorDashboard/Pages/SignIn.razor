@page "/signin"

@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager

<main id="signin" class="signin">
	<section class="signin-form" aria-labelledby="signin-title">
		<h1 id="app-title">ISSUES</h1>
		<p id="signin-title" class="app-subtitle">SAMPLE DASHBOARD</p>
		<div class="signin__notice" role="alert">
			Just click "Log In". This app merely simulates a login process and will accept any values.
		</div>
		<form @onsubmit:preventDefault="true">
			<div class="signin__field">
				<label for="signin-email">Email or username</label>
				<input id="signin-email" type="text" class="signin__input" autocomplete="username" />
			</div>
			<div class="signin__field">
				<label for="signin-password">Password</label>
				<input id="signin-password" type="password" class="signin__input" autocomplete="current-password" />
				<p class="signin__forgot"><a href="help">Forgot your password?</a></p>
			</div>
			<TelerikButton ButtonType="ButtonType.Submit" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" Class="signin__submit" OnClick="@OnLoginClick" Icon="@SvgIcon.Login">Log in</TelerikButton>
		</form>
	</section>
</main>

@code {
	void OnLoginClick()
	{
		navigationManager.NavigateTo("dashboard");
	}
}