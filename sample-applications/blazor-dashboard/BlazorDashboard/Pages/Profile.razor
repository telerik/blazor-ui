@page "/profile"
@using BlazorDashboard.Models
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager


@if (user != null)
{
	<div class="profile__header">
		<div>
			<h2>
				<span class="profile__eyebrow">Account</span>
				@user.Login
				- @user.Name
			</h2>
		</div>
		<div class="profile__header-spacer">
		</div>
		<div>
			<TelerikButton OnClick="@OnSignOutClick">Sign out</TelerikButton>
		</div>
	</div>

	<div class="profile__layout">
		<div class="profile__primary-column">

			<section class="profile__card" id="profile">
				<h3 class="profile__card-header">Public Profile</h3>
				<div class="profile__card-body">
					<div class="profile__details">
						<div class="profile__avatar-wrap">
							<img src="@user.AvatarUrl" alt="@($"{user.Name}'s avatar")" class="profile__avatar" />
						</div>
						<div class="profile__form-column">
							<EditForm Model="@user" OnValidSubmit="@OnUpdateClick">
								<DataAnnotationsValidator />
								<div class="profile__field">
									<label for="username">User Name</label>
									<TelerikTextBox Width="100%" @bind-Value="user.Login" Name="username" />
									<ValidationMessage For="@(() => user.Login)"></ValidationMessage>
								</div>
								<div class="profile__field">
									<label for="real-name">Real Name</label>
									<TelerikTextBox Width="100%" @bind-Value="user.Name" Name="real-name" />
									<ValidationMessage For="@(() => user.Name)"></ValidationMessage>
								</div>
								<div class="profile__field">
									<label for="email">Email</label>
									<TelerikTextBox Width="100%" @bind-Value="user.PublicEmail" Name="email" />
									<ValidationMessage For="@(() => user.PublicEmail)"></ValidationMessage>
								</div>
								<div class="profile__field">
									<label class="profile__checkbox-label">
										<InputCheckbox @bind-Value="user.PrivateEmail" /> Keep my email address private
									</label>
								</div>
								<div class="profile__field">
									<label for="company">Company</label>
									<TelerikTextBox Width="100%" @bind-Value="user.Company" Name="company" />
								</div>
								<div class="profile__field">
									<label for="location">Location</label>
									<TelerikTextBox Width="100%" @bind-Value="user.Location" Name="location" />
								</div>
								<div class="profile__field profile__field--action">
									<TelerikButton ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)">Update profile</TelerikButton>
								</div>
							</EditForm>
						</div>

					</div>
				</div>
			</section>

			<section class="profile__card" id="delete-account">
				<h3 class="profile__card-header">Delete Account</h3>
				<div class="profile__card-body">
					<p>
						You will immediately lose access to your repositories and all other information associated with your account.
						<strong>This cannot be undone!</strong>
					</p>
					<TelerikButton Class="dangerButton" OnClick="@OnDeleteClick" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)">Delete Account</TelerikButton>
				</div>
			</section>
		</div>
		<div class="profile__secondary-column">

			<section class="profile__card" id="notifications">
				<h3 class="profile__card-header">Notifications</h3>
				<div class="profile__card-body">
					<h4 class="profile__subheading">Automatically watch repositories?</h4>
					<p class="profile__muted">
						<label>
							<input type="checkbox" />
							When you are given push access to a repository, automatically receive notifications for it.
						</label>
					</p>
					<label>
						<input type="checkbox" />
						Receive updates to any conversations via email?
					</label>
					<label>
						<input type="checkbox" />
						Receive updates to any repositories via email?
					</label>
				</div>
			</section>
			<section class="profile__card" id="password">
				<h3 class="profile__card-header">Update password</h3>
				<div class="profile__card-body">
					<div class="profile__field">
						<label class="profile__subheading">Old password</label>
						<input type="password" class="profile__input" />
					</div>
					<div class="profile__field">
						<label class="profile__subheading">New password</label>
						<input type="password" class="profile__input" />
					</div>
					<div class="profile__field">
						<label class="profile__subheading">Confirm password</label>
						<input type="password" class="profile__input" />
					</div>
					<div class="profile__field profile__field--action">
						<TelerikButton>Change password</TelerikButton>
					</div>
				</div>
			</section>
		</div>
	</div>


	<TelerikWindow Size="@(ThemeConstants.Window.Size.Small)" Modal="true"  @bind-Visible="@visibleSuccesWindow">
		<WindowTitle>Thank you!</WindowTitle>
		<WindowContent>
			<p>Your profile has been successfully updated.</p>
			<TelerikButton OnClick="@( () => visibleSuccesWindow = false )" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" Class="profile__window-action profile__window-action--full">OK</TelerikButton>
		</WindowContent>
	</TelerikWindow>

	<TelerikWindow Width="450" Modal="true" @bind-Visible="@visibleDeleteWindow">
		<WindowActions>
			<WindowAction Name="Close"></WindowAction>
		</WindowActions>
		<WindowTitle>Are you sure you want to do this?</WindowTitle>
		<WindowContent>
			<p>Account deletion cannot be undone!</p>
			<div>
				<TelerikButton OnClick="@( () => visibleDeleteWindow = false )" Class="profile__window-action">Cancel</TelerikButton>
				<TelerikButton OnClick="@DeleteAccount" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)" Class="profile__window-action">Delete Account</TelerikButton>
			</div>
		</WindowContent>
	</TelerikWindow>
}



@code {
	UserProfile user { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await LoadUser();
	}

	private async Task LoadUser()
	{
		user = new UserProfile()
		{
			Id = 5746515,
			AvatarUrl = "https://avatars1.githubusercontent.com/u/5746515?v=4",
			Company = "Progress Software",
			PublicEmail = "marin.bratanov@progress.com",
			Location = "",
			Login = "marin-bratanov",
			Name = "Marin Bratanov",
			PrivateEmail = true
		};
	}

	void OnSignOutClick()
	{
		GoToLogin();
	}

	bool visibleSuccesWindow = false;
	void OnUpdateClick()
	{
		visibleSuccesWindow = true;
	}

	bool visibleDeleteWindow = false;
	void OnDeleteClick()
	{
		visibleDeleteWindow = true;
	}

	void DeleteAccount()
	{
		GoToLogin();
	}

	void GoToLogin()
	{
		navigationManager.NavigateTo("signin");
	}
}