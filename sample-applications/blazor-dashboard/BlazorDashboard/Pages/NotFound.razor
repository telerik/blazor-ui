@page "/not-found"
@page "/{*path}"

<section class="empty-state" aria-labelledby="not-found-title">
    <h1 id="not-found-title">Page not found</h1>
    <p>The page you requested is unavailable or may have moved.</p>
    <TelerikButton ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" OnClick="@(() => Navigation.NavigateTo("dashboard"))">Return to dashboard</TelerikButton>
</section>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Parameter] public string Path { get; set; } = string.Empty;
}
