@page "/"
@page "/dashboard"

@inject IssuesGenerator IssuesGeneratorService
@implements IDisposable

@using BlazorDashboard.Models
@using BlazorDashboard.DataRetrieval
@using BlazorDashboard.Shared.Charts
@using System.Threading

<div class="dashboard">
	<div class="dashboard__header">
		<div>
			<h2>
				<span class="dashboard__eyebrow">Statistics</span>
				@IssuesFilter.GetRangeFromNumber(timeRange).ToString("ddd, dd MMM yyyy")
				- @DateTime.Now.ToString("ddd, dd MMM yyyy")
			</h2>
		</div>
		<div class="dashboard__header-spacer"></div>
		<div class="dashboard__filter">
			<TelerikDropDownList Width="300px" Data="@DateFilterData" TextField="Text" ValueField="Value" @bind-Value="@timeRange"
                                 OnChange="@LoadIssuesData">
				<DropDownListSettings>
				    <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
				</DropDownListSettings>
			</TelerikDropDownList>
		</div>
	</div>
	<div class="dashboard__layout">
		<section class="dashboard__card dashboard__card--overview">
				<header class="dashboard__card-header">
					<h3>Issue overview</h3>
					<span class="dashboard__muted">Updated @DateTime.Now.ToString("t")</span>
				</header>
				<div class="dashboard__card-body">

					<div class="dashboard__metrics">

						<div class="dashboard__metric dashboard__metric--active">
							<span class="dashboard__metric-label">
								<strong>@IssuesList.Count()</strong>
								<small>Active issues</small>
							</span>
							<IssuesBreakDownCharts ChartData="@IssuesList" SeriesColor="var(--kendo-color-subtle)"></IssuesBreakDownCharts>
						</div>

						<div class="dashboard__metric dashboard__metric--closed">
							<span class="dashboard__metric-label">
								<strong>@ClosedIssues.Count()</strong>
								<small>Closed issues</small>
							</span>
							<IssuesBreakDownCharts ChartData="@ClosedIssues" SeriesColor="var(--kendo-color-success)"></IssuesBreakDownCharts>
						</div>

						<div class="dashboard__metric dashboard__metric--open">
							<span class="dashboard__metric-label">
								<strong>@OpenIssues.Count()</strong>
								<small>Open issues</small>
							</span>
							<IssuesBreakDownCharts ChartData="@OpenIssues" SeriesColor="var(--kendo-color-error)"></IssuesBreakDownCharts>
						</div>

						<div class="dashboard__metric dashboard__metric--rate">
							<span class="dashboard__metric-label">
								<strong>@GetCloseRate()</strong>
								<small>Close rate</small>
							</span>
							<CloseRateChart Open="@OpenIssues.Count()" Closed="@ClosedIssues.Count()"></CloseRateChart>
						</div>
					</div>


					<h3 class="dashboard__section-title">Issue activity</h3>
					<div class="dashboard__activity-chart">
						<AllIssuesChart Data="@IssuesList"></AllIssuesChart>
					</div>
				</div>
		</section>
		<section class="dashboard__card dashboard__card--issue-types">
				<h3 class="dashboard__card-header">Issue Types</h3>
				<div class="dashboard__card-body">
					<IssuesByTypeChart Issues="@IssuesList"></IssuesByTypeChart>
					<div class="dashboard__chart-label">
						<div class="dashboard__metric-label">
						</div>
					</div>
				</div>
		</section>
		<section class="dashboard__card dashboard__card--distribution">
				<h3 class="dashboard__card-header">Types Distribution</h3>
				<div class="dashboard__card-body">
					<TypeDistributionOverTimeChart Issues="@IssuesList"></TypeDistributionOverTimeChart>
				</div>
		</section>
	</div>
</div>

@code {
    IEnumerable<Issue> IssuesList { get; set; } = new List<Issue>();
    IEnumerable<Issue> OpenIssues { get; set; } = new List<Issue>();
    IEnumerable<Issue> ClosedIssues { get; set; } = new List<Issue>();

    CancellationTokenSource stopTimer;

    List<DateFilterModel> DateFilterData;

    int timeRange { get; set; }

    protected override async Task OnInitializedAsync()
    {
        DateFilterData = IssuesFilter.GetTimeRangeFilterValues();
        timeRange = DateFilterData.First().Value;

        await LoadIssuesData();
    }

    public void Dispose()
    {
        StopTimer();
    }

    private async Task LoadDataOnInterval()
    {
        StopTimer();
        stopTimer = new CancellationTokenSource();

        while (IssuesFilter.ShouldForceGeneration(timeRange))
        {
            await Task.Delay(10000, stopTimer.Token);
            await LoadIssuesData();
            StateHasChanged();
        }
    }

    public void StopTimer()
    {
        if (stopTimer != null)
        {
            stopTimer.Cancel();
        }
    }

    private async Task LoadIssuesData()
    {
        IssuesList = await IssuesGeneratorService.GetIssues(IssuesFilter.GetRangeFromNumber(timeRange));
        OpenIssues = IssuesFilter.GetOpenIssues(IssuesList);
        ClosedIssues = IssuesFilter.GetClosedIssues(IssuesList);

        StateHasChanged();

        await LoadDataOnInterval();

        StateHasChanged();
    }

    private MarkupString GetCloseRate()
    {
        double rate = IssuesList.Any() ? (double)ClosedIssues.Count() / IssuesList.Count() : 0;
        return new MarkupString(string.Format("{0:P0}", rate));
    }
}